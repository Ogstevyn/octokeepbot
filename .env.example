# Copy to .env and fill in. Never commit .env.

# Walrus Memory (values from memory.walrus.xyz, SDK credentials panel)
# Relayer: https://relayer.memory.walrus.xyz (mainnet) or https://relayer-staging.memory.walrus.xyz (staging/testnet)
MEMWAL_SERVER_URL=
MEMWAL_NAMESPACE=octokeep
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=

# Telegram bot token from BotFather, and a random secret Telegram echoes on every webhook call
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Postgres connection string (Neon)
DATABASE_URL=

# Random 32-byte hex values: openssl rand -hex 32
# APP_ENCRYPTION_KEY encrypts stored user keys. Back it up; losing it makes them unreadable.
APP_ENCRYPTION_KEY=
CRON_SECRET=

# Language model. LLM_PROVIDER: openai-compatible, anthropic, openai or ollama
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OLLAMA_HOST=http://localhost:11434

# Landing page on Walrus Sites (scripts/deploy-site.sh)
# Network: mainnet or testnet. Epochs: a number or max (53 epochs, about two years on mainnet).
WALRUS_SITE_NETWORK=mainnet
WALRUS_SITE_EPOCHS=max
# Optional path to sites-config.yaml if site-builder cannot find it
SITES_CONFIG=
