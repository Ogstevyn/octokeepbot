# Copy to .env and fill in. Never commit .env.

# Walrus Memory. Accounts made at memory.walrus.xyz use the mainnet relayer
# (the default); staging.memory.walrus.xyz accounts use https://relayer-staging.memory.walrus.xyz
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=octokeep
# Your own credentials (SDK credentials panel). Used by `npm run spike` and by
# `/connect env`, which only Telegram ids in ADMIN_TELEGRAM_IDS may run.
# Every other user connects their own account with /connect.
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
ADMIN_TELEGRAM_IDS=

# Telegram bot token from BotFather, and a random secret Telegram echoes on every webhook call
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Postgres connection string (Neon). Set to memory to try the bot without a database.
DATABASE_URL=

# Random 32-byte hex values: openssl rand -hex 32
# APP_ENCRYPTION_KEY encrypts stored user keys. Back it up; losing it makes them unreadable.
APP_ENCRYPTION_KEY=
CRON_SECRET=

# Language model, any OpenAI-compatible API.
# LLM_PROVIDER: groq, openrouter, openai, ollama, or openai-compatible (then set LLM_BASE_URL).
# LLM_BASE_URL and LLM_MODEL are optional for groq, openrouter, openai and ollama.
LLM_PROVIDER=groq
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OLLAMA_HOST=http://localhost:11434

# Landing page on Walrus Sites (scripts/deploy-site.sh)
# Network: mainnet or testnet. Epochs: a number or max (53 epochs, about two years on mainnet).
WALRUS_SITE_NETWORK=mainnet
WALRUS_SITE_EPOCHS=max
# Optional path to sites-config.yaml if site-builder cannot find it
SITES_CONFIG=
